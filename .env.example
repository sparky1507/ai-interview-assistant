# Copy to .env (next to pom.xml) and fill in. .env is git-ignored and loaded automatically by the app.
# Leave optional settings commented out: an empty "KEY=" line overrides the default with an empty value.

# --- AI provider (Step 3) ---
# openai (default) or ollama (free, local: `docker compose --profile ollama up -d`, see README)
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1

# --- Database (defaults match docker-compose.yml) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=interview_db
# DB_USER=interview
# DB_PASSWORD=interview

# --- Auth ---
# JWT signing key: Base64 of at least 32 random bytes (HS256). Generate with: openssl rand -base64 48
# Optional locally (a dev-only default is built in); REQUIRED anywhere shared or in production.
# JWT_SECRET=
# JWT_EXPIRATION=24h

# Comma-separated list of frontend origins allowed to call the API
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Copy to .env and fill in. .env is git-ignored.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interview_db
DB_USER=interview
DB_PASSWORD=interview

# JWT signing key: Base64 of at least 32 random bytes (HS256). Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=24h

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Added in later steps:
# OPENAI_API_KEY=      (Step 3, if using OpenAI)
